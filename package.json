{
  "name": "codex-desk-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codex Desk Buddy desktop bridge and 320x240 device simulator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "start:mock": "CODEX_DESK_MODE=mock node src/server/index.js",
    "test": "node --test",
    "test:firmware": "node scripts/check-firmware.mjs",
    "setup:firmware-tts": "node scripts/setup-esp-tts.mjs",
    "build:firmware": "pio run -d firmware",
    "release:firmware": "node scripts/build-firmware-release.mjs",
    "flash:firmware": "node scripts/flash-firmware.mjs",
    "check": "node scripts/check.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs"
  },
  "dependencies": {
    "sharp": "0.35.3"
  }
}
