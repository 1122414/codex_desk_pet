{
  "name": "codex-desk-buddy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Codex Desk Buddy desktop bridge and Tab5 device simulator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "start:mock": "CODEX_DESK_MODE=mock node src/server/index.js",
    "install:codex-hooks": "node scripts/install-codex-hooks.mjs",
    "remove:codex-hooks": "node scripts/install-codex-hooks.mjs --remove",
    "install:macos-service": "node scripts/macos-launch-agent.mjs install",
    "remove:macos-service": "node scripts/macos-launch-agent.mjs remove",
    "status:macos-service": "node scripts/macos-launch-agent.mjs status",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test",
    "test:virtual-tab5": "node scripts/verify-virtual-tab5.mjs",
    "test:stability": "node scripts/run-stability.mjs && node scripts/check-firmware.mjs",
    "acceptance:hardware": "node scripts/run-hardware-care-acceptance.mjs",
    "test:firmware": "node scripts/check-firmware.mjs",
    "setup:firmware-tts": "node scripts/setup-esp-tts.mjs",
    "setup:voice-transcription": "node scripts/setup-local-whisper.mjs",
    "build:bundled-pet": "node scripts/build-bundled-pet.mjs",
    "build:firmware": "node scripts/run-platformio.mjs run -d firmware",
    "release:firmware": "node scripts/build-firmware-release.mjs",
    "flash:firmware": "node scripts/flash-firmware.mjs",
    "check": "node scripts/check.mjs",
    "smoke:codex": "node scripts/smoke-codex.mjs"
  },
  "dependencies": {
    "sharp": "0.35.3"
  }
}
